  "sections": {
    "intro": "<section id=\"intro\" class=\"animate-fade-in\">\n            <div class=\"interactive-badge badge-primary\">ICLR 2026 ANALYSIS</div>\n            <h2 class=\"interactive-h2\">TurboQuant: Breaking the Memory Wall</h2>\n            <p class=\"interactive-p mb-8\">\n                An interactive technical report on Google Research's methodology for LLM optimization through online vector quantization, addressing memory bottlenecks without sacrificing accuracy.\n            </p>\n            <div class=\"interactive-card\">\n                <h3 class=\"interactive-h3 mb-4\">Implementation Checklist</h3>\n                <div id=\"scoreDisplay\" class=\"mb-4 text-primary font-bold\"></div>\n                <ul id=\"mitigationChecklist\" class=\"interactive-checklist\"></ul>\n            </div>\n        </section>",
    "problema": "<section id=\"problema\" class=\"animate-fade-in\">\n            <h2 class=\"interactive-h2 flex items-center gap-2\">\n                <span class=\"text-indigo-400\">&#9888;</span> The KV Cache Challenge\n            </h2>\n            <p class=\"interactive-p mb-8\">\n                This section illustrates the exponential growth of memory required during inference. Context storage (Keys and Values) grows linearly per token, but becomes unsustainable under concurrency. Use the calculator to estimate the base footprint for a 70B model (80 layers, 16 KV heads, dimension 128) in FP16.\n            </p>\n\n            <div class=\"interactive-card grid grid-cols-1 lg:grid-cols-2 gap-10 items-center\">\n                <div class=\"space-y-8\">\n                    <div class=\"interactive-box font-mono text-sm\">\n                        Base Memory = 2(K,V) &times; Layers &times; Heads &times; Dim &times; Bytes<br>\n                        = 2 &times; 80 &times; 16 &times; 128 &times; 2 = <span class=\"font-bold text-primary\">640 KB / token</span>\n                    </div>\n\n                    <div class=\"space-y-6\">\n                        <div>\n                            <div class=\"flex justify-between mb-2\">\n                                <label class=\"font-semibold\">Concurrent Users</label>\n                                <span id=\"usersLabel\" class=\"text-primary font-bold bg-primary/10 px-2 py-0.5 rounded\">128</span>\n                            </div>\n                            <input type=\"range\" id=\"usersSlider\" min=\"1\" max=\"512\" value=\"128\" class=\"w-full h-2 bg-surface-container-highest rounded-lg appearance-none cursor-pointer accent-primary\">\n                        </div>\n                        <div>\n                            <div class=\"flex justify-between mb-2\">\n                                <label class=\"font-semibold\">Context Length (Tokens)</label>\n                                <span id=\"tokensLabel\" class=\"text-primary font-bold bg-primary/10 px-2 py-0.5 rounded\">32,000</span>\n                            </div>\n                            <input type=\"range\" id=\"tokensSlider\" min=\"1000\" max=\"128000\" step=\"1000\" value=\"32000\" class=\"w-full h-2 bg-surface-container-highest rounded-lg appearance-none cursor-pointer accent-primary\">\n                        </div>\n                    </div>\n\n                    <div class=\"bg-primary-container text-on-primary-container p-6 rounded-xl shadow-inner border border-primary/20\">\n                        <div class=\"text-xs uppercase tracking-wider font-bold mb-1 opacity-80\">Total Memory Required (FP16)</div>\n                        <div class=\"text-4xl font-extrabold flex items-baseline gap-2\">\n                            <span id=\"totalMemoryText\">2.62</span> <span class=\"interactive-h3 opacity-70\">TB</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"chart-container\">\n                    <canvas id=\"kvCacheChart\"></canvas>\n                </div>\n            </div>\n            <p class=\"mt-6 text-sm text-on-surface-variant max-w-4xl italic text-center\">\n                <strong>Context:</strong> A 2.6 TB memory footprint drastically exceeds the capacity of standard clusters. TurboQuant intervenes by applying online vector quantization, logarithmically compressing this footprint.\n            </p>\n        </section>",
    "arquitectura": "<section id=\"arquitectura\" class=\"animate-fade-in\">\n            <h2 class=\"interactive-h2 flex items-center gap-2\">\n                <span class=\"text-tertiary\">&#9881;</span> Architecture Pipeline\n            </h2>\n            <p class=\"interactive-p mb-8\">\n                Unlike static calibration approaches, this system uses dynamic quantizers and geometric transformations to maximize sparsity and minimize residual error in real-time.\n            </p>\n            \n            <div class=\"interactive-card\">\n                <h3 class=\"interactive-h3 text-center mb-10\">Online Vector Quantization Pipeline</h3>\n                \n                <div class=\"flex flex-col md:flex-row items-center justify-center gap-2 md:gap-4 w-full\">\n                    <div class=\"bg-surface-container border-2 border-outline rounded-xl p-4 text-center flex-1\">\n                        <div class=\"interactive-h3 mb-2\">📂</div>\n                        <div class=\"font-bold text-sm\">Input Tensors</div>\n                        <div class=\"text-xs text-on-surface-variant mt-1\">Pure activations</div>\n                    </div>\n                    <div class=\"interactive-h2 text-on-surface-variant font-bold\">→</div>\n                    \n                    <div class=\"bg-primary/10 border-2 border-primary/30 rounded-xl p-4 text-center flex-1 relative cursor-pointer hover:border-primary transition-colors\" onclick=\"document.getElementById('haarDetails').classList.toggle('hidden')\">\n                        <div class=\"absolute -top-3 -right-3 bg-primary text-on-primary rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold\">i</div>\n                        <div class=\"interactive-h3 mb-2\">🔄</div>\n                        <div class=\"font-bold text-primary text-sm\">Haar Rotation</div>\n                        <div class=\"text-xs text-on-surface-variant mt-1\">Spectral Energy</div>\n                    </div>\n                    <div class=\"interactive-h2 text-on-surface-variant font-bold\">→</div>\n\n                    <div class=\"bg-tertiary/10 border-2 border-tertiary/30 rounded-xl p-4 text-center flex-1\">\n                        <div class=\"interactive-h3 mb-2\">💠</div>\n                        <div class=\"font-bold text-tertiary text-sm\">PolarQuant</div>\n                        <div class=\"text-xs text-on-surface-variant mt-1\">Base Quantization</div>\n                    </div>\n                    <div class=\"interactive-h2 text-on-surface-variant font-bold\">→</div>\n\n                    <div class=\"bg-tertiary/10 border-2 border-tertiary/30 rounded-xl p-4 text-center flex-1 relative cursor-pointer hover:border-tertiary transition-colors\" onclick=\"document.getElementById('qjlDetails').classList.toggle('hidden')\">\n                        <div class=\"absolute -top-3 -right-3 bg-tertiary text-on-primary rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold\">i</div>\n                        <div class=\"interactive-h3 mb-2\">✔</div>\n                        <div class=\"font-bold text-tertiary text-sm\">QJL Correction</div>\n                        <div class=\"text-xs text-on-surface-variant mt-1\">J-L Lemma</div>\n                    </div>\n                    <div class=\"interactive-h2 text-on-surface-variant font-bold\">→</div>\n\n                    <div class=\"bg-surface-container-highest border-2 border-primary rounded-xl p-4 text-center flex-1 shadow-lg shadow-primary/20\">\n                        <div class=\"interactive-h3 mb-2\">🖤</div>\n                        <div class=\"font-bold text-on-surface text-sm\">KV Cache OK</div>\n                        <div class=\"text-xs text-primary mt-1 font-bold\">Optimized</div>\n                    </div>\n                </div>\n\n                <div id=\"haarDetails\" class=\"hidden mt-8 interactive-box border-primary/30 text-sm\">\n                    <strong>About Haar Rotation:</strong> Application of a random orthogonal rotation. SHOULD NOT be confused with classic <em>whitening</em>. The Haar matrix simply distributes spectral energy uniformly, preparing the tensor for highly efficient sparsity induction.\n                </div>\n                <div id=\"qjlDetails\" class=\"hidden mt-4 interactive-box border-tertiary/30 text-sm\">\n                    <strong>QJL Residual Correction:</strong> After discretization, residuals accumulate. Applying the Johnson-Lindenstrauss Lemma, these residuals are statistically compressed, ensuring relative distances are preserved with high fidelity.\n                </div>\n            </div>\n        </section>",
    "geometria": "<section id=\"geometria\" class=\"animate-fade-in\">\n            <h2 class=\"interactive-h2 flex items-center gap-2\">\n                <span class=\"text-indigo-400\">📐</span> Dynamic Geometry\n            </h2>\n            <p class=\"interactive-p mb-8\">\n                The authors demonstrate that, due to geometric behavior in high-dimensional spheres, after applying rotation, the resulting distribution of tensor elements is modeled as a perfect <strong>Gaussian</strong>. This allows for optimal bit allocation.\n            </p>\n            \n            <div class=\"interactive-card\">\n                <h3 class=\"interactive-h3 mb-6 text-center\">Central Limit Theorem on Spheres</h3>\n                <div class=\"chart-container\">\n                    <canvas id=\"distributionChart\"></canvas>\n                </div>\n                <p class=\"text-xs text-center text-on-surface-variant mt-6 italic\">\n                    Fig: Gaussian distribution (Post-Haar) allows for much more precise quantization mapping than the original Beta distribution.\n                </p>\n            </div>\n        </section>",
    "rendimiento": "<section id=\"rendimiento\" class=\"animate-fade-in\">\n            <h2 class=\"interactive-h2 flex items-center gap-2\">\n                <span class=\"text-secondary\">📊</span> Performance Comparison\n            </h2>\n            <p class=\"interactive-p mb-8\">\n                We analyze the hardware limits motivating optimization and compare TurboQuant with RaBitQ, focusing on stability under extreme scenarios (Tail Bounds).\n            </p>\n\n            <div class=\"interactive-grid\">\n                <div class=\"interactive-card\">\n                    <h3 class=\"text-lg font-bold mb-2 text-primary\">Hardware Limits</h3>\n                    <p class=\"text-xs text-on-surface-variant mb-6\">Physical bandwidth (TB/s). Memory Bound inference.</p>\n                    <div class=\"h-[300px]\">\n                        <canvas id=\"hardwareChart\"></canvas>\n                    </div>\n                </div>\n\n                <div class=\"interactive-card\">\n                    <h3 class=\"text-lg font-bold mb-2 text-secondary\">Error Bounds (Tail Bounds)</h3>\n                    <p class=\"text-xs text-on-surface-variant mb-6\">Degradation in extreme percentiles vs RaBitQ.</p>\n                    <div class=\"h-[300px]\">\n                        <canvas id=\"tailBoundChart\"></canvas>\n                    </div>\n                </div>\n            </div>\n        </section>",
    "ecosistema": "<section id=\"ecosistema\" class=\"animate-fade-in\">\n            <h2 class=\"interactive-h2 flex items-center gap-2\">\n                <span class=\"text-primary\">🌍</span> Ecosystem Impact\n            </h2>\n            <p class=\"interactive-p mb-10\">\n                The introduction of online vector quantization directly impacts open-source development and Edge AI paradigms.\n            </p>\n\n            <div class=\"interactive-grid\">\n                <div class=\"interactive-card border-t-4 border-t-primary hover:translate-y-[-5px] transition-transform\">\n                    <div class=\"interactive-h2 mb-4\">💻</div>\n                    <h4 class=\"text-lg font-bold mb-2\">vLLM Integration</h4>\n                    <p class=\"text-sm text-on-surface-variant\">\n                        Discussions are ongoing regarding <strong>PagedAttention</strong> compatible kernels that support real-time matrix rotations.\n                    </p>\n                </div>\n\n                <div class=\"interactive-card border-t-4 border-t-secondary hover:translate-y-[-5px] transition-transform\">\n                    <div class=\"interactive-h2 mb-4\">📱</div>\n                    <h4 class=\"text-lg font-bold mb-2\">Apple Silicon</h4>\n                    <p class=\"text-sm text-on-surface-variant\">\n                        Frameworks like <strong>MLX</strong> can load giant models in unified RAM without requiring dedicated VRAM.\n                    </p>\n                </div>\n\n                <div class=\"interactive-card border-t-4 border-t-tertiary hover:translate-y-[-5px] transition-transform\">\n                    <div class=\"interactive-h2 mb-4\">📈</div>\n                    <h4 class=\"text-lg font-bold mb-2\">HBM Market</h4>\n                    <p class=\"text-sm text-on-surface-variant\">\n                        Extreme compression could alter high-bandwidth memory demand forecasts in data centers.\n                    </p>\n                </div>\n            </div>\n        </section>"
  },
